# Copy this file to .env.local and fill in values from your Firebase
# project settings (Project settings -> General -> Your apps -> SDK setup).
# .env.local is gitignored and must never be committed.
#
# Enable in the Firebase console:
#   - Authentication -> Sign-in method -> Anonymous (and/or Google)
#   - Firestore Database (production mode; rules are in firestore.rules)
#   - Realtime Database (production mode; rules are in database.rules.json)

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_DATABASE_URL=
